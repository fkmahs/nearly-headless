#!/bin/sh
# Run nearly-headless with this checkout first on the path. Git Bash on Windows has no working python3: use py there.
# When this laptop's settings name another checkout as its kit (`kit = "..."`, written by nh setup), forward to it,
# so `nh` from this folder on the PATH runs that one. `nh setup` never forwards: it makes this checkout the kit.
KIT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -z "$NH_FORWARDED" ] && [ "$1" != "setup" ]; then
  S="${NH_SETTINGS:-$HOME/.nearly-headless/settings.toml}"
  if [ -f "$S" ]; then
    T="$(sed -n -e '/^[[:space:]]*\[/q' -e 's/^kit[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$S" | head -n 1)"
    if [ -n "$T" ] && [ -f "$T/bin/nh" ] && [ "$(cd "$T" && pwd -P)" != "$(cd "$KIT" && pwd -P)" ]; then
      NH_FORWARDED="$(cd "$KIT" && (pwd -W 2>/dev/null || pwd))"
      export NH_FORWARDED
      exec sh "$T/bin/nh" "$@"
    fi
  fi
fi
# Python 3.11 or newer: python3, else a newer one installed beside an older system python3, else py (Windows).
PY=py
for C in python3 python3.13 python3.12 python3.11; do
  if "$C" -c "import sys; sys.exit(sys.version_info < (3, 11))" 2>/dev/null; then PY="$C"; break; fi
done
PYTHONPATH="$KIT${PYTHONPATH:+:$PYTHONPATH}" PYTHONIOENCODING=utf-8 exec "$PY" -P -m wk "$@"
